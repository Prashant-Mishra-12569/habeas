# Copy to .env.local and fill in. Testnet-only keys; never commit real values.
# The Habeas "issuer" operator key for the demo asset (opens demo cases, mints).
HABEAS_ISSUER_SECRET=
# Relayer: pays the network fee for free answers and settles cases.
RELAYER_SECRET=
# The demo reviewer (decides answered demo cases in Try it live).
HABEAS_REVIEWER_SECRET=
# Signs every paid agent check answer; its public key is published at /api/v1/key.
HABEAS_ATTEST_SECRET=
# Optional overrides
# TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# MAINNET_RPC_URL=https://mainnet.sorobanrpc.com
# X402_PAY_TO=G...                                  (who receives payments)
# X402_FACILITATOR_URL=https://x402.org/facilitator
