{
  "name": "habeas-mcp",
  "private": true,
  "type": "module",
  "description": "MCP server for Habeas and Soroban: lets AI agents read cases, check tokens and build unsigned transactions on Stellar. Never holds a signing key.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/stdio.ts",
    "start:http": "node --env-file-if-exists=.env src/http.ts",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@x402/fetch": "^2.28.0",
    "@x402/stellar": "^2.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
