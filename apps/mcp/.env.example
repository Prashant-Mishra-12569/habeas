# Copy to .env. Testnet-only keys; never commit real values. Everything here is optional.
# Which network the Soroban tools use when a call doesn't say (testnet, futurenet, mainnet).
# STELLAR_NETWORK=testnet
# TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# MAINNET_RPC_URL=https://mainnet.sorobanrpc.com
# Habeas website, used to build unsigned transactions and to buy signed token checks.
# HABEAS_URL=https://habeas-stellar.vercel.app
# Local only: a testnet account with a little testnet USDC turns on check_asset (0.001 USDC per call).
# scripts/setup-x402.mjs in the repository root makes one.
AGENT_SECRET=
# Hosted HTTP server
# PORT=8787
# MCP_AUTH_TOKEN=          (if set, clients must send Authorization: Bearer <token>)
# RATE_LIMIT_PER_MIN=60
# Local tools
# SOROBAN_CLI_PATH=stellar
# LOG_LEVEL=info
