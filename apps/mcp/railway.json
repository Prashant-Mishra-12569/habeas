{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/mcp/Dockerfile",
    "watchPatterns": ["apps/mcp/**", "deployments/testnet.json", "docs/SPEC-cases.md"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ALWAYS"
  }
}
