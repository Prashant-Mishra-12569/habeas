{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/alerts/Dockerfile",
    "watchPatterns": ["apps/alerts/**", "deployments/testnet.json", "railway.json"]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
